      "item": [
        {
          "name": "Register",
          "id": "e487d2e6-8136-4c16-8a38-e80c4053ab66",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.employee@company.com\",\n  \"password\": \"Emp@123\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Employee\",\n  \"role\": \"EMPLOYEE\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"phone\": \"9000000099\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "POST /api/auth/register (AuthController#register -> RegisterRequest). `role` defaults to EMPLOYEE if omitted. Response is wrapped in the standard ApiResponse envelope: `{ success, message, data: { token, type, user }, errors, timestamp }`."
          },
          "response": []
        },
        {
          "name": "Login",
          "id": "d5b23a31-8e88-4a82-a2f9-74927d5afe24",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// AuthController wraps the AuthResponse in ApiResponse<T>, so the",
                  "// token is at response.data.token, not the top level.",
                  "let jsonData;",
                  "try {",
                  "    jsonData = pm.response.json();",
                  "} catch (e) {",
                  "    jsonData = {};",
                  "}",
                  "",
                  "pm.test('Login succeeded (status 200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const token = jsonData.data && jsonData.data.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Saved token to collection variable `token`.');",
                  "} else {",
                  "    console.warn('No data.token field found in login response body.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "POST /api/auth/login (AuthController#login -> LoginRequest). Login with admin@company.com / Admin@123 (or john.doe@company.com / Emp@123). The JWT at `data.token` is auto-saved to the `token` collection variable by the test script."
          },
          "response": []
        },
        {
          "name": "Me (not yet implemented)",
          "id": "95a1cf92-2421-48ac-83d6-c698e4292d38",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Requested for this submission, but AuthController currently only exposes /register and /login - there is no /me endpoint yet. Add:\n\n@GetMapping(\"/me\")\npublic ResponseEntity<ApiResponse<UserResponse>> me(Authentication authentication) { ... }\n\nto AuthController (resolving the user via authentication.getName()) to make this request work."
          },
          "response": []
        }
      ]
    },
